############################################
# Environment Selector
############################################
# Set to DEV, TEST, or PROD — all environment-specific keys below
# are prefixed accordingly. The app reads ${APP_ENV}_KEY → KEY.
APP_ENV=DEV

############################################
# Global (same across all environments)
############################################
APP_NAME=NeuraLeads AI Agent
LOG_LEVEL=INFO
TIMEZONE=America/Chicago

# Data Storage
DATA_STORAGE=database

# Business Rules
DAILY_SEND_LIMIT=30
COOLDOWN_DAYS=10
MAX_CONTACTS_PER_COMPANY_PER_JOB=4
MIN_SALARY_THRESHOLD=30000
DATA_RETENTION_DAYS=180
# Max company size (employees) for lead sourcing. Pushed server-side into
# TheirStack's max_employee_count filter so larger companies are never fetched.
# Override per-tenant via Settings -> Source Tuning (job_source_tuning.theirstack).
THEIRSTACK_MAX_EMPLOYEE_COUNT=200

# Email Sending Mode
EMAIL_SEND_MODE=mailmerge

# Provider Selection (mock for dev/test, real for prod)
CONTACT_PROVIDER=mock
EMAIL_VALIDATION_PROVIDER=mock

############################################
# Billing, Plans & Credits
############################################
# Plans are free / pro / max / custom. The per-plan allowances and limits are NOT
# env vars — they are product pricing and live in backend/app/core/plans.py
# (PLAN_MATRIX), so they can never drift between environments.
BILLING_ENABLED=false

# Credit enforcement is OFF by default: turning it on is always an explicit decision
# so it can never silently 402 a live pipeline. Can also be enabled per-tenant via
# the `credit_enforcement_enabled` setting.
CREDIT_ENFORCEMENT_ENABLED=false

# Deployment-only overrides of the monthly credit allowance (staging caps, load
# tests). 0 = use PLAN_MATRIX, which is what production should run.
CREDIT_LIMIT_FREE_OVERRIDE=0
CREDIT_LIMIT_PRO_OVERRIDE=0
CREDIT_LIMIT_MAX_OVERRIDE=0

# Credit top-ups: $10 per 1,000 credits, never expire.
CREDIT_TOPUP_BLOCK_SIZE=1000
CREDIT_TOPUP_BLOCK_PRICE_CENTS=1000


############################################
# Transactional (system) email
############################################
# Verification, password resets, deal notifications and invoices. SEPARATE from
# EMAIL_SEND_MODE above, which governs campaign/cold outreach through each tenant's
# OWN mailboxes. Never point cold outreach at a transactional provider — Resend and
# every comparable service prohibits it in their terms, and one shared sender would
# put every tenant's deliverability behind a single reputation.
#
#   auto   = Resend if a key is set, else global SMTP (default)
#   resend = force Resend, no silent SMTP fallback
#   smtp   = force global SMTP
#   none   = disable global system mail (tenant-configured senders still work)
SYSTEM_MAIL_PROVIDER=auto

############################################
# TEST
############################################
TEST_DB_TYPE=sqlite
TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_NAME=
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_SECRET_KEY=test-secret-key-not-for-production
TEST_ENCRYPTION_KEY=
TEST_REDIS_URL=redis://localhost:6379/1
TEST_DEBUG=true
TEST_HOST=127.0.0.1
TEST_PORT=8000
TEST_BASE_URL=http://localhost:8000
TEST_CORS_ORIGINS=http://localhost:3000

############################################
# DEV
############################################
DEV_DB_TYPE=mysql
DEV_DB_HOST=localhost
DEV_DB_PORT=3306
DEV_DB_NAME=exzelon_ra_agent
DEV_DB_USER=ra_user
DEV_DB_PASSWORD=
DEV_SECRET_KEY=
DEV_ENCRYPTION_KEY=
DEV_REDIS_URL=redis://localhost:6379/0
DEV_DEBUG=true
DEV_HOST=127.0.0.1
DEV_PORT=8000
DEV_BASE_URL=http://localhost:8000
DEV_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003

# API Keys (dev)
DEV_JSEARCH_API_KEY=
# Firecrawl — scrapes LinkedIn/Indeed job pages for applicant counts (high-applicant gate).
# Optional; the gate stays off until this is set AND lead_sourcing_scrape_applicants is enabled.
DEV_FIRECRAWL_API_KEY=
DEV_APOLLO_API_KEY=
DEV_SEAMLESS_API_KEY=
DEV_NEVERBOUNCE_API_KEY=
DEV_ZEROBOUNCE_API_KEY=
DEV_HUNTER_API_KEY=
DEV_CLEAROUT_API_KEY=

# LOB-specific Lead Source Keys (dev)
DEV_GOOGLE_PLACES_API_KEY=
DEV_CRUNCHBASE_API_KEY=
DEV_BUILTWITH_API_KEY=
DEV_GITHUB_TOKEN=

# SMTP (dev)
DEV_SMTP_HOST=
DEV_SMTP_PORT=587
DEV_SMTP_USER=
DEV_SMTP_PASSWORD=

# Stripe (dev — use test-mode keys and test-mode price ids)
# Free has no price (nothing is charged) and Custom is invoiced by contract through
# the ManualGateway, so neither has a price id. Subscriptions stay inert until set.
DEV_STRIPE_SECRET_KEY=
DEV_STRIPE_PUBLISHABLE_KEY=
DEV_STRIPE_WEBHOOK_SECRET=
DEV_STRIPE_PRICE_PRO=
DEV_STRIPE_PRICE_MAX=
DEV_STRIPE_PRICE_PRO_ANNUAL=
DEV_STRIPE_PRICE_MAX_ANNUAL=
DEV_STRIPE_PRICE_CREDIT_TOPUP=

# Resend (dev) — the API key is SEND-ONLY scoped in Resend; never commit a real one.
# RESEND_FROM_EMAIL must be on a domain verified in Resend. `onboarding@resend.dev`
# is their shared test sender and only delivers to the account owner.
DEV_RESEND_API_KEY=
DEV_RESEND_FROM_EMAIL=
DEV_RESEND_FROM_NAME=NeuraLeads

# Admin seeding (dev)
DEV_ADMIN_EMAIL=admin@exzelon.com
DEV_ADMIN_PASSWORD=

# Optional OS-specific paths
# DEV_EXPORT_PATH_WIN=C:\path\to\exports
# DEV_EXPORT_PATH_LINUX=/var/data/exports

############################################
# PROD
############################################
PROD_DB_TYPE=mysql
PROD_DB_HOST=
PROD_DB_PORT=3306
PROD_DB_NAME=exzelon_ra_agent
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_SECRET_KEY=
PROD_ENCRYPTION_KEY=
PROD_REDIS_URL=redis://localhost:6379/0
PROD_DEBUG=false
PROD_HOST=0.0.0.0
PROD_PORT=8000
PROD_BASE_URL=https://yourdomain.com
PROD_CORS_ORIGINS=https://yourdomain.com

# API Keys (prod)
PROD_JSEARCH_API_KEY=
PROD_APOLLO_API_KEY=
PROD_SEAMLESS_API_KEY=

# LOB-specific Lead Source Keys (prod)
PROD_GOOGLE_PLACES_API_KEY=
PROD_CRUNCHBASE_API_KEY=
PROD_BUILTWITH_API_KEY=
PROD_GITHUB_TOKEN=

# SMTP (prod)
PROD_SMTP_HOST=
PROD_SMTP_PORT=587
PROD_SMTP_USER=
PROD_SMTP_PASSWORD=

# Stripe (prod — live keys and live price ids)
PROD_STRIPE_SECRET_KEY=
PROD_STRIPE_PUBLISHABLE_KEY=
PROD_STRIPE_WEBHOOK_SECRET=
PROD_STRIPE_PRICE_PRO=
PROD_STRIPE_PRICE_MAX=
PROD_STRIPE_PRICE_PRO_ANNUAL=
PROD_STRIPE_PRICE_MAX_ANNUAL=
PROD_STRIPE_PRICE_CREDIT_TOPUP=

# Resend (prod) — the API key is SEND-ONLY scoped in Resend; never commit a real one.
# RESEND_FROM_EMAIL must be on a domain verified in Resend. `onboarding@resend.dev`
# is their shared test sender and only delivers to the account owner.
PROD_RESEND_API_KEY=
PROD_RESEND_FROM_EMAIL=
PROD_RESEND_FROM_NAME=NeuraLeads

# Admin seeding (prod)
PROD_ADMIN_EMAIL=admin@exzelon.com
PROD_ADMIN_PASSWORD=

# Docker-specific (used by docker-compose)
DB_ROOT_PASSWORD=
