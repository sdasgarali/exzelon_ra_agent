# Database
*.db
*.sqlite3
# SQLite WAL sidecars (journal_mode=WAL) and local backups — `*.db` does not
# match these, because the suffix is `-wal` / `-shm` rather than an extension.
*.db-wal
*.db-shm
*.db.bak-*

# OS
.DS_Store
Thumbs.db

# Docker
.docker/

# Screenshots & images
*.png
*.jpg
*.jpeg
*.gif
images/
test_screenshots/

# ...but brand artwork is shipped product code, not a screenshot. Without these
# negations the blanket *.png rule silently drops the logo/favicon from the
# deploy and every brand image 404s in production.
!frontend/public/brand/*.png
!frontend/src/app/icon.png
!frontend/src/app/apple-icon.png

# Claude Code
.claude/

# Stray / dev artifacts
.last_startup.json
kill_python.py
test_m365.py
start_app.py

# Data exports
backend/data/exports/
backend/data/*.backup
backend/data/backups/
backend/data/invoices/

# Misc
*.bak
*.tmp
*.temp
*.docx

# Firecrawl research artifacts
.firecrawl/

# QA testing artifacts (do not commit)
.env.qa.local
qa-results/
qa-enterprise/evidence/
qa-enterprise/report/
.playwright-mcp/
