# NeuraLeads MCP connector — copy to .env (never commit .env)
# Optional: APP_ENV=TEST|DEV|PROD makes ${APP_ENV}_X override X for every key below.
NEURALEADS_API_URL=https://neuraleads.ai/api/v1
# stdio mode only. Hosted (http) mode ignores it and uses each caller's key.
NEURALEADS_API_KEY=
NEURALEADS_MCP_READ_ONLY=false
NEURALEADS_TIMEOUT_SECONDS=60
NEURALEADS_MAX_RETRIES=2
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8010
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
MCP_LOG_LEVEL=INFO
